---
// src/pages/record/[slug].astro
import { Image, getImage } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import Tracklist from '../../components/Tracklist.astro'
import DetailFacts from '../../components/DetailFacts.astro'
import { collection, wantlist, coverFor, imageFor } from '../../lib/data'
import type { VinylRecord } from '../../lib/schema'

export function getStaticPaths() {
  // A record that appears in both collection and wantlist shares one release
  // id and (sync.ts assigns slugs by id) one slug — it must produce a single
  // page, not two competing ones. Dedupe by id first; collection wins ties.
  const byId = new Map<number, VinylRecord>()
  for (const record of wantlist) byId.set(record.id, record)
  for (const record of collection) byId.set(record.id, record)
  const all = [...byId.values()]

  // Ids are already unique here, so any slug collision left standing means
  // two DIFFERENT release ids produced the same slug — a real defect.
  const seen = new Set<string>()
  const duplicates = new Set<string>()
  for (const record of all) {
    if (seen.has(record.slug)) duplicates.add(record.slug)
    seen.add(record.slug)
  }
  if (duplicates.size > 0) {
    throw new Error(`Duplicate record slug(s): ${[...duplicates].join(', ')}`)
  }
  return all.map((record) => ({ params: { slug: record.slug }, props: { record } }))
}

interface Props { record: VinylRecord }
const { record } = Astro.props
const cover = coverFor(record.coverFile)
const label = `${record.primaryArtist} — ${record.title}`
const eyebrow = [record.label, record.catno, record.country].filter(Boolean).join(' · ')

// The full-size URL for the cover and each secondary image, so the lightbox
// (src/scripts/gallery.ts) can show the full-resolution asset without
// hardcoding any path — it just reads each button's data-full.
const coverFull = cover ? (await getImage({ src: cover })).src : null
const thumbs = (
  await Promise.all(
    record.images.map(async (image) => {
      const asset = imageFor(image.file)
      if (!asset) return null
      const full = await getImage({ src: asset })
      return { asset, fullSrc: full.src }
    }),
  )
).filter((thumb) => thumb !== null)
---
<Base title={label}>
  <a class="back" href={import.meta.env.BASE_URL}>&larr; Collection</a>
  <article class="detail">
    <div class="art" data-label={label}>
      {cover && (
        <button type="button" class="cover-btn" data-full={coverFull} aria-label={`View full-size photo — ${label}`}>
          <Image
            src={cover}
            alt={label}
            widths={[430, 860]}
            sizes="(min-width: 900px) min(46vw, 720px), 100vw"
            class="cover"
            transition:name={`cover-${record.slug}`}
          />
        </button>
      )}
      {thumbs.length > 0 && (
        <div class="thumbs">
          {thumbs.map((thumb, index) => (
            <button
              type="button"
              aria-label={`Show photo ${index + 1} of ${thumbs.length}`}
              data-full={thumb.fullSrc}
            >
              <Image src={thumb.asset} alt="" widths={[64, 128]} sizes="64px" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="info">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{record.title}</h1>
      <p class="by">{record.artist}</p>

      <div class="tags">
        {record.genres.map((genre) => <span class="genre">{genre}</span>)}
        {record.styles.map((style) => <span class="style">{style}</span>)}
      </div>

      <DetailFacts record={record} />
      <Tracklist record={record} />

      <div class="two">
        {record.credits.length > 0 && (
          <section class="block">
            <h3>Credits</h3>
            {record.credits.slice(0, 12).map((credit) => (
              <div class="row"><span class="k">{credit.role}</span><span class="v">{credit.name}</span></div>
            ))}
            {record.credits.length > 12 && (
              <p class="more">+{record.credits.length - 12} more</p>
            )}
          </section>
        )}

        {record.identifiers.length > 0 && (
          <section class="block">
            <h3>Pressing details</h3>
            {record.identifiers.map((identifier) => (
              <div class="row">
                <span class="k">{identifier.type}{identifier.description ? ` — ${identifier.description}` : ''}</span>
                <span class="v mono">{identifier.value}</span>
              </div>
            ))}
          </section>
        )}
      </div>

      {record.notes && (
        <section class="block"><h3>Notes</h3><p class="notes">{record.notes}</p></section>
      )}
    </div>
  </article>
</Base>

<script>
  import { initGallery } from '../../scripts/gallery'

  // See index.astro's astro:page-load comment — same rewiring applies here.
  document.addEventListener('astro:page-load', () => {
    initGallery()
  })
</script>

<style>
  .back { display: inline-block; margin-top: 26px; font-size: 12px; color: var(--dim); }
  .back:hover { color: var(--ink); }

  /* The cover column scales with the viewport (no more fixed 430px cap now
     that the page has no max-width container) but stops growing past 720px
     so it doesn't dominate an ultra-wide window. */
  .detail { display: grid; grid-template-columns: minmax(300px, min(46vw, 720px)) 1fr; gap: 46px; align-items: start; padding: 16px 0 40px; }
  @media (max-width: 900px) { .detail { grid-template-columns: 1fr; } }

  /* Fixed square box, letterboxed (object-fit: contain) so a horizontal
     spread is fully visible and the layout never jumps between records —
     only the lightbox shows an image at its natural aspect ratio. */
  .cover-btn {
    all: unset;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    cursor: pointer;
    overflow: hidden;
    background: var(--panel);
    box-shadow: 0 22px 50px rgb(0 0 0 / 0.6);
  }
  .cover-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cover-btn :global(.cover) { width: 100%; height: 100%; object-fit: contain; display: block; }

  /* Small wrapping thumbnails — never a horizontal scroller, never full-size
     stacks. The BUTTON (not the img) is the grid item and owns the square
     sizing, so wrapping the img in a button can't distort it. */
  .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 8px; margin-top: 12px; }
  .thumbs button {
    all: unset;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    overflow: hidden;
    cursor: pointer;
    display: block;
  }
  .thumbs button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0.6; transition: opacity 0.18s; }
  .thumbs :global(img:hover) { opacity: 1; }

  .eyebrow { font-size: 11.5px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--dim); margin: 0 0 8px; }
  h1 { margin: 0 0 6px; font-size: 34px; line-height: 1.1; letter-spacing: -0.02em; font-weight: 680; }
  .by { margin: 0 0 16px; font-size: 16px; color: #c8bfb4; }

  .tags { display: flex; flex-wrap: wrap; gap: 5px; }
  .genre, .style { font-size: 11px; padding: 3px 9px; border-radius: 99px; }
  .genre { background: var(--accent); color: #17130c; font-weight: 640; }
  .style { background: var(--panel); color: #b3a99e; }

  .block { margin-top: 26px; }
  .block h3 { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-bottom: 11px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; }
  @media (max-width: 820px) { .two { grid-template-columns: 1fr; } }

  .row { display: flex; gap: 12px; font-size: 12.5px; padding: 4px 0; }
  .k { color: var(--faint); flex: 0 0 150px; }
  .v { flex: 1; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px; color: #b3a99e; }
  .more { margin: 6px 0 0; font-size: 11px; color: var(--faint); }
  .notes { font-size: 13px; line-height: 1.62; color: #c0b7ac; max-width: 66ch; }

  /* The lightbox dialog is created and appended to <body> by gallery.ts, so
     it never receives this component's scoped data-astro-cid attribute —
     every rule targeting it must be :global(). */
  /* Open: backdrop fades in and the image pops up from a slight scale —
     fast and eased-out so it reads as arriving, not flashing on. Close is
     the same pair run in reverse but a touch quicker, via the standard
     trick of giving the base (closed) selector its own, shorter
     transition — that's the one used when the is-open class is removed. */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.14s ease-in, visibility 0s linear 0.14s;
  }
  :global(.lightbox.is-open) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.18s ease-out;
  }
  :global(.lightbox-backdrop) {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.94);
    cursor: pointer;
  }
  :global(.lightbox-dialog) {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    transform: scale(0.96);
    transition: transform 0.14s ease-in;
  }
  :global(.lightbox.is-open .lightbox-dialog) {
    transform: scale(1);
    transition: transform 0.18s var(--ease-settle);
  }
  :global(.lightbox-dialog:focus) { outline: none; }
  :global(.lightbox-img) {
    /* gallery.ts sets an explicit width/height in px once the image's
       natural size is known, scaling it UP to fill up to 90vw/90vh —
       these max-width/max-height rules are only a no-JS/pre-load fallback
       so the image never overflows the viewport before that runs. */
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    image-rendering: auto;
    display: block;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }
  /* Stepping to another image (prev/next or arrow keys) restarts this via a
     class toggle in gallery.ts — a quick fade-in reads as a crossfade
     without needing to keep two <img> elements in sync. */
  @keyframes lightbox-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  :global(.lightbox-img.is-switching) {
    animation: lightbox-fade-in 0.14s ease-out;
  }
  :global(.lightbox-close) {
    all: unset;
    position: fixed;
    top: 20px;
    right: 28px;
    cursor: pointer;
    font-size: 30px;
    line-height: 1;
    color: var(--ink);
    padding: 6px 10px;
  }
  :global(.lightbox-close:hover) { color: var(--accent); }
  :global(.lightbox-close:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Prev/next sit at the outer edges of the fullscreen overlay (not the
     dialog box, which can be much narrower than the viewport) with a
     generously padded hit area. gallery.ts hides both via [hidden] when a
     record has only one image. */
  :global(.lightbox-nav) {
    all: unset;
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    cursor: pointer;
    font-size: 34px;
    line-height: 1;
    color: var(--ink);
    z-index: 1;
  }
  :global(.lightbox-prev) { left: 6px; }
  :global(.lightbox-next) { right: 6px; }
  :global(.lightbox-nav:hover) { color: var(--accent); }
  :global(.lightbox-nav:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(.lightbox-nav[hidden]) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    :global(.lightbox),
    :global(.lightbox.is-open),
    :global(.lightbox-dialog),
    :global(.lightbox.is-open .lightbox-dialog) {
      transition: none;
    }
    :global(.lightbox-img.is-switching) { animation: none; }
  }
</style>
