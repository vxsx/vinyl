---
// src/layouts/Base.astro
import '../styles/tokens.css'
import { wantlist } from '../lib/data'

interface Props { title: string; description?: string }
const { title, description = 'A vinyl collection' } = Astro.props
const base = import.meta.env.BASE_URL
const path = Astro.url.pathname

// Known at build time: with nothing on the wishlist there's nowhere for the
// second link to go, so the whole nav (and its bar) is omitted rather than
// left empty.
const showNav = wantlist.length > 0
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="wrap">
      {showNav && (
        <header class="site-header">
          <nav>
            <a href={base} aria-current={path === base ? 'page' : undefined}>Collection</a>
            <a href={`${base}wishlist/`} aria-current={path.includes('wishlist') ? 'page' : undefined}>Wishlist</a>
          </nav>
        </header>
      )}
      <main><slot /></main>
    </div>
  </body>
</html>
