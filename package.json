{
  "name": "vinyl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "node --env-file-if-exists=.env --import tsx scripts/sync.ts",
    "capture-fixtures": "node --env-file-if-exists=.env --import tsx scripts/capture-fixtures.ts",
    "test": "vitest run",
    "verify": "npm run build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/build.test.ts --config vitest.build.config.ts"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "sharp": "^0.33.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
